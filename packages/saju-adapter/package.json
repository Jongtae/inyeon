{
  "name": "@inyeon/saju-adapter",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "INYEON-owned deterministic Korean Saju adapter boundary",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSES.md",
    "PROVENANCE.md",
    "data"
  ],
  "scripts": {
    "prebuild": "npm run build --workspace @inyeon/timezone-resolver",
    "build": "tsc -p tsconfig.build.json",
    "pretypecheck": "npm run build --workspace @inyeon/timezone-resolver",
    "typecheck": "tsc --noEmit --pretty false",
    "preverify:data": "npm run build --workspace @inyeon/timezone-resolver",
    "verify:data": "node scripts/generate-differential-corpus.mjs --check && node scripts/generate-solar-term-boundaries.mjs --check && node scripts/generate-year-month-differential.mjs --check && node scripts/generate-day-hour-evidence.mjs --check",
    "test": "npm run verify:data && vitest run"
  },
  "dependencies": {
    "@inyeon/timezone-resolver": "0.1.0",
    "manseryeok": "2.0.0"
  },
  "devDependencies": {
    "@types/node": "24.13.4",
    "astronomy-engine": "2.1.19",
    "lunar-javascript": "1.7.7",
    "typescript": "6.0.3",
    "vitest": "5.0.0"
  }
}

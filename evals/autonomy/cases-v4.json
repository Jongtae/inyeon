    "INVESTIGATION": ["NONE", "INVESTIGATE_ONLY"],
    "AUTHORIZATION": ["NONE", "INVESTIGATE_ONLY", "EXPERIMENT_ONLY", "BOUNDED_IMPLEMENTATION", "ROUTINE_OPERATION", "POLICY_REPAIR", "PAUSE_FOR_HUMAN"],
    "IMPLEMENTATION": ["NONE", "EXPERIMENT_ONLY", "BOUNDED_IMPLEMENTATION", "ROUTINE_OPERATION", "POLICY_REPAIR"],
    "RECOVERY": ["NONE", "RECOVER_AND_VERIFY", "CONTAIN_AND_REMEDIATE"]
  },
  "execution_action_compatibility": {

{
  "schema_version": 4,
  "description": "Scorer-only lifecycle and execution-separation contract using factual contexts not present in schema v1-v3.",
  "allowed_vocabularies": {
    "lifecycle_stage": ["INTAKE", "INVESTIGATION", "AUTHORIZATION", "IMPLEMENTATION", "RECOVERY"],
    "analysis_owner": ["PRODUCT_JUDGE", "FEEDBACK_ANALYST", "METHODOLOGY_REVIEW", "REDDIT_OPERATOR", "QA", "SECURITY_REVIEWER", "ARCHITECT", "EXPLORER"],
    "decision_authority": ["PRODUCT_JUDGE", "FEEDBACK_ANALYST", "METHODOLOGY_REVIEW", "REDDIT_OPERATOR", "QA", "SECURITY_REVIEWER", "ARCHITECT", "EXPLORER", "HUMAN_GATE"],
    "decision": ["ACT", "OBSERVE", "EXPERIMENT", "INVESTIGATE", "IGNORE", "STRIP_UNTRUSTED_INSTRUCTION", "PAUSE_METHOD_CHANGE", "ARCHITECTURE_REVIEW", "REQUEST_MINIMAL_HUMAN_STEP", "AUTONOMOUS", "RESPECT_PLATFORM_LIMIT", "DO_NOT_POST_YET", "DO_NOT_EXPAND_SCOPE", "ROLLBACK_OR_FIX_BEFORE_CONTINUE", "BLOCK_RELEASE_AND_FIX", "BLOCK_RELEASE_AND_REMEDIATE", "REPAIR_POLICY_CONFLICT"],
    "action_authorization": ["NONE", "INVESTIGATE_ONLY", "EXPERIMENT_ONLY", "BOUNDED_IMPLEMENTATION", "ROUTINE_OPERATION", "RECOVER_AND_VERIFY", "CONTAIN_AND_REMEDIATE", "POLICY_REPAIR", "PAUSE_FOR_HUMAN"],
    "execution_owner": ["NONE", "OPERATOR", "WORKER", "FEEDBACK_ANALYST", "METHODOLOGY_REVIEW", "REDDIT_OPERATOR", "QA", "SECURITY_REVIEWER", "ARCHITECT", "EXPLORER"]
  },
  "role_decision_compatibility": {

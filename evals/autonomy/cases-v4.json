    {"id":"N428","scenario":"A reversible explanation-copy experiment is preregistered and approved, and a worker is implementing only the experiment flag and exposure test before release.","expected":{"lifecycle_stage":"IMPLEMENTATION","analysis_owner":"FEEDBACK_ANALYST","decision_authority":"PRODUCT_JUDGE","decision":"EXPERIMENT","human_gate":false,"action_authorization":"EXPERIMENT_ONLY","execution_owner":"WORKER"},"accepted_alternatives":[],"critical_category":null,"critical_expectations":{}},

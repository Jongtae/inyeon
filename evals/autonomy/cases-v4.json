    "ARCHITECT": ["ARCHITECTURE_REVIEW", "DO_NOT_EXPAND_SCOPE", "REPAIR_POLICY_CONFLICT"],
    "EXPLORER": ["INVESTIGATE", "STRIP_UNTRUSTED_INSTRUCTION"],
    "HUMAN_GATE": ["REQUEST_MINIMAL_HUMAN_STEP", "DO_NOT_POST_YET", "PAUSE_METHOD_CHANGE"]
